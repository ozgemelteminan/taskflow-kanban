generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  boards        Board[]
  activities    Activity[]
}

model Board {
  id        String    @id @default(cuid())
  name      String
  color     String    @default("#7c6ef5")
  emoji     String    @default("📋")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns   Column[]
  activities Activity[]

  @@index([userId])
}

model Column {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#7c6ef5")
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId])
}

model Card {
  id        String   @id @default(cuid())
  title     String
  desc      String?
  order     Int
  priority  String   @default("low")
  due       DateTime?
  assignee  String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  columnId  String
  column    Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  fromCol   String?
  toCol     String?
  createdAt DateTime @default(now())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId])
}
